# Copy to .env (or export) — all optional for local demo
VERIFICLINK_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=            # enables AI-generated questions + AI grading
VERIFICLINK_MODEL=claude-sonnet-5-5
GITHUB_TOKEN=                 # raises GitHub API rate limit for repo checks
COOLDOWN_MINUTES=30           # wait time after a failed/abandoned attempt
REQUIRE_CAMERA=1              # 0 to allow tests without a webcam (dev only)
STRICT_REPO_CHECK=0           # 1 = reject if GitHub/Crossref can't be reached
SEED_DEMO=1                   # 0 = don't create demo accounts
